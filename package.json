{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "npm run typecheck:app && npm run typecheck:templates",
    "typecheck:app": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:templates": "node tools/genesis/templates/entity/validate-templates.mjs",
    "lint": "eslint",
    "lint:quality-gate": "eslint tests/tools/genesis/entity-template-validation.test.ts tools/genesis/templates/entity/TemplateRenderer.mjs tools/genesis/templates/entity/validate-templates.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:template-validation": "jest --runInBand tests/tools/genesis/entity-template-validation.test.ts",
    "test:quality-regression": "jest --runInBand tests/identity tests/gop/auth-runtime-compatibility.test.ts tests/gop/authorization-boundary.test.ts tests/gop/authorization-resolver.test.ts tests/gop/mission-control-authorization.test.ts",
    "quality:ci": "npm run typecheck && npm run lint:quality-gate && npm run test:template-validation && npm run test:quality-regression",
    "gar:scan": "node tools/genesis-audit/src/run.mjs",
    "gar:test": "jest tests/genesis-audit --runInBand",
    "gar2:scan": "node tools/genesis-audit/src/gar-0002-run.mjs",
    "gar2:validate": "node tools/genesis-audit/src/gar-0002-validate.mjs",
    "gar2:test": "jest tests/genesis-audit/gar-0002 --runInBand",
    "atlas:guardrails": "node tools/atlas-guardrails/src/check.mjs",
    "atlas:test": "jest tests/atlas-guardrails --runInBand",
    "atlas:regression": "jest --runTestsByPath tests/gop/platform-bootstrap-api.test.ts tests/gop/loader-context.test.ts tests/gop/authorization-boundary.test.ts tests/gop/auth-runtime-compatibility.test.ts tests/gop/runtime-event-store-composition.test.ts tests/gop/prisma-execution-repository-composition.test.ts tests/gop/operations-api.test.ts tests/gop/orchestration-runtime.test.ts tests/gop/runtime-fabric.test.ts",
    "atlas:certify": "npm run atlas:guardrails && npm run atlas:test && npm run atlas:regression",
    "evidence-ir:process-zach": "npx tsx src/evidence-ir/process-zach-evidence.mts",
    "evidence-ir:process-madison": "npx tsx src/evidence-ir/process-madison-evidence.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/pdf-parse": "^1.1.5",
    "next": "16.2.10",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  }
}
