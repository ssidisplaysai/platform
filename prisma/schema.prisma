generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum GlwJobType {
  PAGE_GENERATION
  BLOG_GENERATION
}

enum GlwJobStatus {
  QUEUED
  STARTING
  RUNNING
  GENERATING_CONTENT
  GENERATING_IMAGE
  UPLOADING_IMAGE
  PUBLISHING
  COMPLETE
  FAILED_QA
  FAILED
}

enum GlwBusinessStatus {
  UNKNOWN
  IN_PROGRESS
  COMPLETE
  FAILED
  FAILED_QA
}

enum GlwCallbackDeliveryStatus {
  NOT_READY
  PENDING
  RETRYING
  ACKNOWLEDGED
  DEAD_LETTER
}

enum GlwCallbackReceiptOutcome {
  RECEIVED
  APPLIED
  ALREADY_APPLIED
  CONFLICT
  REJECTED
}

enum GlwDailyPublishPlanStatus {
  DRAFT
  APPROVED
  PAUSED
  EXECUTING
  COMPLETE
}

enum GlwDailyPublishCandidateAction {
  CREATE_STATE
  CREATE_CITY
  UPDATE_CITY
  SKIP_EXISTING
  BLOCKED_PARENT
  BLOCKED_DUPLICATE
  BLOCKED_QA
  BLOCKED_SITE
}

enum GlwDailyPublishCandidateApprovalStatus {
  PENDING
  APPROVED
  EXCLUDED
  BLOCKED
  QUEUED
  SKIPPED_ALREADY_QUEUED
}

model GlwJob {
  id                     String                     @id @default(cuid())
  type                   GlwJobType
  status                 GlwJobStatus
  retryOfJobId           String?
  siteId                 String
  title                  String
  input                  Json
  result                 Json?
  error                  Json?
  externalExecutionId    String?
  operationKey           String?                    @unique
  businessStatus         GlwBusinessStatus?
  callbackDeliveryStatus GlwCallbackDeliveryStatus?
  terminalReceiptId      String?
  publicationKey         String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([type, createdAt(sort: Desc)])
  @@index([siteId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([retryOfJobId])
  @@index([businessStatus, updatedAt(sort: Desc)])
  @@index([callbackDeliveryStatus, updatedAt(sort: Desc)])
  @@index([publicationKey])
}

model GlwCallbackReceipt {
  receiptId          String                    @id @default(cuid())
  idempotencyKey     String                    @unique
  terminalScopeKey   String                    @unique
  operationKey       String
  jobId              String
  externalExecutionId String
  callbackType       String
  terminalStatus     String
  payloadSha256      String
  payloadJson        Json
  outcome            GlwCallbackReceiptOutcome
  receivedAt         DateTime                  @default(now())
  appliedAt          DateTime?
  responseStatus     Int?
  conflictReason     String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([jobId, receivedAt(sort: Desc)])
  @@index([operationKey, receivedAt(sort: Desc)])
  @@index([externalExecutionId, receivedAt(sort: Desc)])
  @@index([outcome, receivedAt(sort: Desc)])
}

model GlwDailyPublishPlan {
  id                  String                    @id @default(cuid())
  siteId              String
  generatedAt         DateTime
  status              GlwDailyPublishPlanStatus @default(DRAFT)
  dailyPageLimit      Int
  hourlyPageLimit     Int
  maxConcurrentJobs   Int
  retryLimit          Int
  minimumDelaySeconds Int
  summaryJson         Json
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  candidates GlwDailyPublishCandidate[]

  @@index([siteId, generatedAt(sort: Desc)])
  @@index([status, generatedAt(sort: Desc)])
}

model GlwDailyPublishCandidate {
  id                 String                                @id @default(cuid())
  planId             String
  siteId             String
  productId          String
  productSlug        String
  stateName          String
  stateSlug          String
  cityName           String?
  citySlug           String?
  canonicalPath      String
  desiredAction      GlwDailyPublishCandidateAction
  priority           Int
  reason             String
  existingWordPressId String?
  existingStatus     String?
  parentProductId    String?
  parentStateId      String?
  approvalStatus     GlwDailyPublishCandidateApprovalStatus @default(PENDING)
  queueJobId         String?
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt

  plan GlwDailyPublishPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, canonicalPath])
  @@index([siteId, desiredAction])
  @@index([approvalStatus, priority])
  @@index([queueJobId])
}

model GlwPublishingControl {
  siteId           String   @id
  paused           Boolean  @default(false)
  pausedAt         DateTime?
  pausedBy         String?
  publishingEnabled Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([paused, updatedAt(sort: Desc)])
}

model GopJobEvent {
  eventId        String   @id
  jobId          String
  moduleId       String
  jobType        String
  eventType      String
  stage          String?
  status         String?
  message        String?
  source         String?
  occurredAt     DateTime
  sequence       Int
  durationMs     Int?
  metadata       Json?
  actorId        String?
  actorName      String?
  correlationId  String?
  causationId    String?
  idempotencyKey String?
  createdAt      DateTime @default(now())

  @@unique([jobId, sequence])
  @@index([jobId, sequence])
  @@index([moduleId, occurredAt(sort: Desc)])
  @@index([jobType, occurredAt(sort: Desc)])
  @@index([eventType, occurredAt(sort: Desc)])
  @@index([status, occurredAt(sort: Desc)])
  @@index([idempotencyKey])
  @@unique([jobId, idempotencyKey], map: "GopJobEvent_jobId_idempotencyKey_unique_when_not_null", where: raw("\"idempotencyKey\" IS NOT NULL"))
}

model GopExecution {
  executionId       String   @id
  executionType     String?
  jobId             String?  @unique
  moduleId          String
  workspaceId       String
  parentExecutionId String?
  childExecutionIds Json
  status            String
  currentState      String?
  currentNodeId     String?
  priority          String
  queueName         String?
  workerAssignment  Json?
  retryCount        Int      @default(0)
  retryHistory      Json
  startedAt         DateTime?
  completedAt       DateTime?
  scheduledAt       DateTime?
  timeoutMs         Int?
  correlationId     String?
  causationId       String?
  context           Json
  input             Json
  output            Json?
  artifacts         Json
  metadata          Json?
  executionVersion  Int      @default(1)
  snapshotVersion   Int      @default(1)
  archivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  snapshots GopExecutionSnapshot[]
  leases    GopExecutionLease[]
  deadLetters GopDeadLetter[]

  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([moduleId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([parentExecutionId])
  @@index([correlationId])
}

model GopExecutionSnapshot {
  snapshotId       String   @id @default(cuid())
  executionId      String
  snapshotVersion  Int
  snapshotSequence Int
  status           String
  currentState     String?
  currentNodeId    String?
  progressPercent  Int
  queuePosition    Int?
  workerAssignment Json?
  retryCount       Int
  retryHistory     Json
  output           Json?
  timing           Json
  metrics          Json
  artifacts        Json
  state            Json
  upToEventSequence Int?
  metadata         Json?
  createdAt        DateTime @default(now())

  execution GopExecution @relation(fields: [executionId], references: [executionId], onDelete: Cascade)

  @@unique([executionId, snapshotSequence])
  @@index([executionId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model GopWorker {
  workerId                   String   @id
  name                       String
  workerType                 String
  capabilities               Json
  maxCapacity                Int
  currentWorkload            Int      @default(0)
  heartbeatAt                DateTime
  health                     String
  protocolVersion            String
  supportedProtocolVersions  Json
  instanceId                 String?
  environment                String?
  tokenId                    String?
  authMode                   String
  leaseTtlMs                 Int?
  heartbeatIntervalMs        Int?
  lastLeaseId                String?
  disconnectedAt             DateTime?
  workspaceId                String?
  moduleId                   String?
  metadata                   Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([workerType, updatedAt(sort: Desc)])
  @@index([health, updatedAt(sort: Desc)])
  @@index([workspaceId, moduleId])
}

model GopExecutionLease {
  leaseId              String   @id
  executionId          String
  queueItemId          String
  workerId             String
  workspaceId          String
  moduleId             String
  leaseStartAt         DateTime
  leaseExpiresAt       DateTime
  heartbeatDeadlineAt  DateTime
  renewalCount         Int      @default(0)
  leaseState           String
  protocolVersion      String
  tokenId              String?
  stolenFromWorkerId   String?
  releasedAt           DateTime?
  releaseReason        String?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  execution GopExecution @relation(fields: [executionId], references: [executionId], onDelete: Cascade)

  @@index([executionId, leaseStartAt(sort: Desc)])
  @@index([workerId, leaseStartAt(sort: Desc)])
  @@index([leaseState, leaseExpiresAt(sort: Desc)])
}

model GopDeadLetter {
  deadLetterId   String   @id
  executionId    String
  queueItemId    String
  workspaceId    String
  moduleId       String
  queueName      String?
  reason         String
  retryHistory   Json
  failureHistory Json
  operatorNotes  String?
  archivedAt     DateTime?
  recoveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  execution GopExecution @relation(fields: [executionId], references: [executionId], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([moduleId, createdAt(sort: Desc)])
  @@index([archivedAt, createdAt(sort: Desc)])
}

model GopRecoveryRecord {
  id                      String   @id @default(cuid())
  workspaceId             String
  moduleId                String
  jobId                   String
  executionId             String?
  previousJobStatus       String
  newJobStatus            String
  previousExecutionStatus String?
  newExecutionStatus      String?
  reason                  String
  recoveredBy             String
  dryRun                  Boolean  @default(true)
  safeRecovery            Boolean  @default(false)
  metadata                Json?
  createdAt               DateTime @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([jobId, createdAt(sort: Desc)])
  @@index([executionId, createdAt(sort: Desc)])
}

model GmpProject {
  projectId            String   @id
  name                 String
  slug                 String
  description          String?
  organization         String?
  workspaceId          String
  ownerActorId         String
  members              Json
  status               String
  lifecycleState       String
  businessProfileRef   String?
  businessGenomeRef    String?
  defaultLanguage      String
  defaultLocale        String
  timezone             String
  metadata             Json?
  version              Int      @default(1)
  archivedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  brandProfile         GmpBrandProfile?
  sites                GmpSite[]
  environmentConfigs   GmpEnvironmentConfig[]
  knowledgeWorkspace   GmpBusinessKnowledgeWorkspace?
  knowledgeRecords     GmpKnowledgeRecord[]
  knowledgeSources     GmpKnowledgeSource[]
  knowledgeEvidenceLinks GmpKnowledgeEvidenceLink[]
  knowledgeReviews     GmpKnowledgeReview[]
  knowledgeApprovals   GmpKnowledgeApproval[]
  knowledgeConflicts   GmpKnowledgeConflict[]
  knowledgeConflictMembers GmpKnowledgeConflictMember[]
  knowledgeCompletenessAssessments GmpKnowledgeCompletenessAssessment[]
  contextAssemblies    GmpContextAssemblyRecord[]
  pages                GmpPage[]
  pageBriefs           GmpPageBrief[]
  pageBriefVersions    GmpPageBriefVersion[]
  contentPlans         GmpContentPlan[]
  contentPlanVersions  GmpContentPlanVersion[]
  pageSections         GmpPageSection[]
  pageRelationships    GmpPageRelationship[]
  internalLinkPlans    GmpInternalLinkPlan[]
  pageReviews          GmpPageReview[]
  pageApprovals        GmpPageApproval[]
  pageReadinessAssessments GmpPageReadinessAssessment[]
  pageKnowledgeReferences GmpPageKnowledgeReference[]
  pageSourceReferences GmpPageSourceReference[]
  contentDrafts        GmpContentDraft[]
  generationRequests   GmpGenerationRequest[]
  contentReviews       GmpContentReview[]
  contentApprovals     GmpContentApproval[]
  contentValidations   GmpContentValidation[]
  sectionValidations   GmpSectionValidation[]
  generationLineage    GmpGenerationLineage[]
  contentAssemblies    GmpContentAssembly[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
}

model GmpSite {
  siteId                  String   @id
  projectId               String
  displayName             String
  primaryDomain           String
  environment             String
  publishingPlatform      String
  publishingStatus        String
  authenticationMethod    String
  connectionStatus        String
  publishingCapabilities  Json
  defaultLanguage         String
  defaultTheme            String?
  metadata                Json?
  version                 Int      @default(1)
  archivedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  project                 GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  publishingConnections   GmpPublishingConnection[]
  environmentConfigs      GmpEnvironmentConfig[]
  pages                   GmpPage[]
  contentDrafts           GmpContentDraft[]

  @@index([projectId, updatedAt(sort: Desc)])
  @@index([environment, updatedAt(sort: Desc)])
  @@index([connectionStatus, updatedAt(sort: Desc)])
}

model GmpBrandProfile {
  brandProfileId      String   @id
  projectId           String   @unique
  companyName         String
  tagline             String?
  mission             String?
  brandVoice          String?
  writingStyle        String?
  primaryAudience     String?
  secondaryAudience   String?
  primaryColor        String?
  secondaryColor      String?
  logoReferences      Json
  typography          Json?
  assetReferences     Json
  socialLinks         Json
  contactInformation  Json?
  metadata            Json?
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project             GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([updatedAt(sort: Desc)])
}

model GmpPublishingConnection {
  connectionId           String   @id
  siteId                 String
  provider               String
  environment            String
  publishingStatus       String
  authenticationMethod   String
  connectionStatus       String
  publishingCapabilities Json
  configuration          Json?
  metadata               Json?
  version                Int      @default(1)
  lastValidatedAt        DateTime?
  archivedAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  site                   GmpSite @relation(fields: [siteId], references: [siteId], onDelete: Cascade)

  @@index([siteId, updatedAt(sort: Desc)])
  @@index([provider, updatedAt(sort: Desc)])
  @@index([connectionStatus, updatedAt(sort: Desc)])
}

model GmpEnvironmentConfig {
  configId       String   @id
  projectId      String?
  siteId         String?
  environment    String
  variables      Json
  metadata       Json?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        GmpProject? @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  site           GmpSite? @relation(fields: [siteId], references: [siteId], onDelete: Cascade)

  @@index([projectId, environment])
  @@index([siteId, environment])
}

model GmpBusinessKnowledgeWorkspace {
  knowledgeWorkspaceId String   @id
  projectId            String   @unique
  workspaceVersion     Int      @default(1)
  status               String
  lifecycleState       String
  completenessScore    Int      @default(0)
  confidenceScore      Int      @default(0)
  lastReviewedAt       DateTime?
  lastApprovedAt       DateTime?
  approvedBy           String?
  metadata             Json?
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project                  GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  records                  GmpKnowledgeRecord[]
  reviews                  GmpKnowledgeReview[]
  approvals                GmpKnowledgeApproval[]
  conflicts                GmpKnowledgeConflict[]
  completenessAssessments  GmpKnowledgeCompletenessAssessment[]
  contextAssemblies        GmpContextAssemblyRecord[]

  @@index([lifecycleState, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
}

model GmpKnowledgeRecord {
  knowledgeRecordId       String   @id
  projectId               String
  knowledgeWorkspaceId    String
  domain                  String
  recordType              String
  canonicalKey            String
  title                   String
  summary                 String?
  structuredValue         Json
  normalizedValue         Json?
  status                  String
  confidence              Int      @default(50)
  priority                Int      @default(50)
  effectiveFrom           DateTime?
  effectiveUntil          DateTime?
  sourceCount             Int      @default(0)
  conflictState           String   @default("NONE")
  reviewState             String   @default("DRAFT")
  supersededByRecordId    String?
  parentRecordId          String?
  version                 Int      @default(1)
  archivedAt              DateTime?
  metadata                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  project                 GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  workspace               GmpBusinessKnowledgeWorkspace @relation(fields: [knowledgeWorkspaceId], references: [knowledgeWorkspaceId], onDelete: Cascade)
  parentRecord            GmpKnowledgeRecord? @relation("GmpKnowledgeRecordParent", fields: [parentRecordId], references: [knowledgeRecordId], onDelete: SetNull)
  childRecords            GmpKnowledgeRecord[] @relation("GmpKnowledgeRecordParent")
  supersededByRecord      GmpKnowledgeRecord? @relation("GmpKnowledgeRecordSupersede", fields: [supersededByRecordId], references: [knowledgeRecordId], onDelete: SetNull)
  supersedesRecords       GmpKnowledgeRecord[] @relation("GmpKnowledgeRecordSupersede")
  versions                GmpKnowledgeRecordVersion[]
  evidenceLinks           GmpKnowledgeEvidenceLink[]
  reviews                 GmpKnowledgeReview[]
  approvals               GmpKnowledgeApproval[]
  conflictMembers         GmpKnowledgeConflictMember[]

  @@index([projectId, domain, updatedAt(sort: Desc)])
  @@index([knowledgeWorkspaceId, canonicalKey])
  @@index([reviewState, updatedAt(sort: Desc)])
  @@index([conflictState, updatedAt(sort: Desc)])
  @@index([status, effectiveUntil])
}

model GmpKnowledgeRecordVersion {
  knowledgeRecordVersionId String   @id
  knowledgeRecordId        String
  projectId                String
  knowledgeWorkspaceId     String
  versionNumber            Int
  previousValue            Json?
  newValue                 Json
  changeReason             String?
  changedBy                String
  changedAt                DateTime @default(now())
  sourceImpact             Json?
  approvalImpact           Json?
  metadata                 Json?
  createdAt                DateTime @default(now())

  record                   GmpKnowledgeRecord @relation(fields: [knowledgeRecordId], references: [knowledgeRecordId], onDelete: Cascade)

  @@unique([knowledgeRecordId, versionNumber])
  @@index([projectId, changedAt(sort: Desc)])
  @@index([knowledgeWorkspaceId, changedAt(sort: Desc)])
}

model GmpKnowledgeSource {
  sourceId             String   @id
  projectId            String
  sourceType           String
  displayName          String
  locationReference    String?
  externalIdentifier   String?
  checksum             String?
  sourceVersion        String?
  capturedAt           DateTime?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project              GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  evidenceLinks        GmpKnowledgeEvidenceLink[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([sourceType, createdAt(sort: Desc)])
}

model GmpKnowledgeEvidenceLink {
  knowledgeEvidenceLinkId String   @id
  projectId               String
  knowledgeRecordId       String
  sourceId                String
  evidenceLocation        String?
  evidenceSummary         String?
  extractionMethod        String?
  confidence              Int      @default(50)
  verifiedBy              String?
  verifiedAt              DateTime?
  metadata                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  project                 GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  record                  GmpKnowledgeRecord @relation(fields: [knowledgeRecordId], references: [knowledgeRecordId], onDelete: Cascade)
  source                  GmpKnowledgeSource @relation(fields: [sourceId], references: [sourceId], onDelete: Cascade)

  @@unique([knowledgeRecordId, sourceId, evidenceLocation])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([sourceId, createdAt(sort: Desc)])
}

model GmpKnowledgeReview {
  knowledgeReviewId      String   @id
  projectId              String
  knowledgeWorkspaceId   String
  knowledgeRecordId      String
  assignedTo             String?
  reviewState            String
  operatorNotes          String?
  reviewNotes            String?
  requestedBy            String?
  requestedAt            DateTime?
  completedBy            String?
  completedAt            DateTime?
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project                GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  workspace              GmpBusinessKnowledgeWorkspace @relation(fields: [knowledgeWorkspaceId], references: [knowledgeWorkspaceId], onDelete: Cascade)
  record                 GmpKnowledgeRecord @relation(fields: [knowledgeRecordId], references: [knowledgeRecordId], onDelete: Cascade)

  @@index([projectId, reviewState, updatedAt(sort: Desc)])
  @@index([knowledgeRecordId, updatedAt(sort: Desc)])
}

model GmpKnowledgeApproval {
  knowledgeApprovalId    String   @id
  projectId              String
  knowledgeWorkspaceId   String
  knowledgeRecordId      String
  decision               String
  approvalNotes          String?
  decidedBy              String
  decidedAt              DateTime
  metadata               Json?
  createdAt              DateTime @default(now())

  project                GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  workspace              GmpBusinessKnowledgeWorkspace @relation(fields: [knowledgeWorkspaceId], references: [knowledgeWorkspaceId], onDelete: Cascade)
  record                 GmpKnowledgeRecord @relation(fields: [knowledgeRecordId], references: [knowledgeRecordId], onDelete: Cascade)

  @@index([projectId, decidedAt(sort: Desc)])
  @@index([knowledgeRecordId, decidedAt(sort: Desc)])
}

model GmpKnowledgeConflict {
  knowledgeConflictId    String   @id
  projectId              String
  knowledgeWorkspaceId   String
  conflictGroup          String
  conflictReason         String
  severity               String
  resolutionStatus       String
  selectedRecordId       String?
  resolutionNotes        String?
  resolvedBy             String?
  resolvedAt             DateTime?
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project                GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  workspace              GmpBusinessKnowledgeWorkspace @relation(fields: [knowledgeWorkspaceId], references: [knowledgeWorkspaceId], onDelete: Cascade)
  members                GmpKnowledgeConflictMember[]

  @@index([projectId, resolutionStatus, updatedAt(sort: Desc)])
  @@index([severity, updatedAt(sort: Desc)])
}

model GmpKnowledgeConflictMember {
  knowledgeConflictMemberId String   @id
  projectId                 String
  knowledgeConflictId       String
  knowledgeRecordId         String
  role                      String?
  metadata                  Json?
  createdAt                 DateTime @default(now())

  project                   GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  conflict                  GmpKnowledgeConflict @relation(fields: [knowledgeConflictId], references: [knowledgeConflictId], onDelete: Cascade)
  record                    GmpKnowledgeRecord @relation(fields: [knowledgeRecordId], references: [knowledgeRecordId], onDelete: Cascade)

  @@unique([knowledgeConflictId, knowledgeRecordId])
  @@index([projectId, createdAt(sort: Desc)])
}

model GmpKnowledgeCompletenessAssessment {
  knowledgeCompletenessAssessmentId String   @id
  projectId                         String
  knowledgeWorkspaceId              String
  scoringModelVersion               String
  overallScore                      Int
  domainScores                      Json
  missingCriticalFields             Json
  missingRecommendedFields          Json
  conflictedFields                  Json
  unapprovedFields                  Json
  expiredFields                     Json
  metadata                          Json?
  createdAt                         DateTime @default(now())

  project                           GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  workspace                         GmpBusinessKnowledgeWorkspace @relation(fields: [knowledgeWorkspaceId], references: [knowledgeWorkspaceId], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([knowledgeWorkspaceId, createdAt(sort: Desc)])
}

model GmpContextAssemblyRecord {
  contextAssemblyRecordId  String   @id
  projectId                String
  knowledgeWorkspaceId     String
  siteId                   String?
  operationType            String
  previewMode              Boolean  @default(false)
  inputMetadata            Json?
  assembledContext         Json
  schemaVersion            String
  knowledgeWorkspaceVersion Int
  recordVersions           Json
  gopExecutionId           String?
  createdBy                String?
  metadata                 Json?
  createdAt                DateTime @default(now())

  project                  GmpProject @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  workspace                GmpBusinessKnowledgeWorkspace @relation(fields: [knowledgeWorkspaceId], references: [knowledgeWorkspaceId], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([knowledgeWorkspaceId, createdAt(sort: Desc)])
  @@index([operationType, createdAt(sort: Desc)])
}

model GmpPage {
  pageId                     String   @id
  projectId                  String
  siteId                     String
  parentPageId               String?
  pageType                   String
  pageTemplateType           String
