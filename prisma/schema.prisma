  @@index([status, generatedAt(sort: Desc)])
}

model GedAuditLineage {
  enterpriseAuditLineageId String   @id
  entityKey               String
  actorId                 String
  eventType               String
  summary                 String
  relatedEntityKeys       Json
  occurredAt              DateTime
  immutableLineage        String

  @@index([entityKey, occurredAt(sort: Desc)])
  @@index([eventType, occurredAt(sort: Desc)])
}
