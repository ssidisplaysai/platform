{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gafs-0001/evidence-bindings.schema.json",
  "type": "object",
  "required": ["schemaIdentifier", "schemaVersion", "bindings"],
  "properties": {
    "schemaIdentifier": { "const": "gafs-0001/evidence-bindings" },
    "schemaVersion": { "type": "string" },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bindingId", "evidenceId", "targetType", "targetId"],
        "properties": {
          "bindingId": { "type": "string" },
          "evidenceId": { "type": "string" },
          "targetType": { "type": "string" },
          "targetId": { "type": "string" },
          "relationship": { "type": "string" }
        }
      }
    }
  }
}