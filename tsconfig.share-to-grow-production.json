{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/app/api/share-to-grow/**/*.ts",
    "src/app/api/health/**/*.ts",
    "src/modules/share-to-grow/**/*.ts",
    "src/modules/foundation/foundation-persistence.ts",
    "src/modules/foundation/foundation-state-store.ts",
    "src/modules/foundation/postgres-foundation-state-store.ts",
    "src/modules/foundation/production-persistence-guards.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
