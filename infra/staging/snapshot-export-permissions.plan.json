{
  "status": "approved-not-applied",
  "scope": "staging-only-share-to-grow-snapshot-export",
  "provisioningReadiness": "NOT_READY",
  "clusterArn": "arn:aws:ecs:us-west-2:452630323448:cluster/genesis-production",
  "taskDefinitionFamily": "genesis-staging-snapshot-export",
  "namespace": "share-to-grow-repository",
  "sourceRepositories": {
    "postgres": {
      "database": "genesis_staging",
      "table": "public.genesis_foundation_state",
      "namespace": "share-to-grow-repository"
    },
    "filesystem": {
      "path": "/mnt/genesis-persistence/foundation/share-to-grow-repository.json"
    }
  },
  "artifactStorage": {
    "bucketLogicalName": "StagingSnapshotArtifactBucket",
    "kmsKeyLogicalName": "StagingSnapshotArtifactKey",
    "runPrefixPattern": "exports/<reconciliation-run-id>/",
    "retentionDays": 2
  },
  "newRoles": [
    {
      "roleLogicalName": "StagingSnapshotExporterRole",
      "purpose": "Read-only staging snapshot exporter task role",
      "prohibitedActions": [
        "ecs:UpdateService",
        "rds:ModifyDBInstance",
        "rds:DeleteDBInstance",
        "secretsmanager:PutSecretValue",
        "s3:PutBucketPolicy",
        "s3:PutBucketAcl"
      ]
    },
    {
      "roleLogicalName": "StagingSnapshotReaderRole",
      "purpose": "Retrieve run-scoped encrypted artifacts for local dry-run only",
      "prohibitedActions": [
        "ecs:*",
        "rds:*",
        "secretsmanager:*",
        "s3:PutObject"
      ]
    },
    {
      "roleLogicalName": "StagingSnapshotOperatorRole",
      "purpose": "Launch only approved staging one-off snapshot export tasks",
      "prohibitedActions": [
        "ecs:UpdateService",
        "cloudformation:ExecuteChangeSet",
        "iam:CreateRole",
        "iam:PutRolePolicy"
      ]
    }
  ],
  "databaseRoleProvisioningRequirements": {
    "roleName": "genesis_share_to_grow_snapshot_reader",
    "database": "genesis_staging",
    "requiredGrants": [
      "CONNECT ON DATABASE genesis_staging",
      "USAGE ON SCHEMA public",
      "SELECT ON TABLE public.genesis_foundation_state"
    ],
    "requiredRevokes": [
      "REVOKE CREATE ON SCHEMA public",
      "REVOKE ALL ON ALL TABLES IN SCHEMA public",
      "REVOKE ALL ON ALL SEQUENCES IN SCHEMA public",
      "REVOKE ALL ON ALL FUNCTIONS IN SCHEMA public"
    ],
    "prohibitedCapabilities": [
      "INSERT",
      "UPDATE",
      "DELETE",
      "TRUNCATE",
      "CREATE",
      "ALTER",
      "DROP",
      "GRANT OPTION",
      "CREATEROLE",
      "SUPERUSER",
      "BYPASSRLS",
      "REPLICATION"
    ],
    "mustUseDedicatedSecret": "SNAPSHOT_DB_READER_SECRET_ARN"
  },
  "currentBlockers": [
    {
      "code": "ECS_OVERRIDE_IMMUTABILITY_UNRESOLVED",
      "description": "Direct ecs:RunTask allows caller-controlled container overrides that can redirect destinations. Provisioning requires a controlled launch broker that strips overrides and signs allowed run parameters."
    }
  ],
  "requiredApprovalsBeforeApply": [
    "Security architecture review",
    "IAM least-privilege review",
    "Data-handling and retention sign-off",
    "Staging change window approval"
  ]
}
