# syntax=docker/dockerfile:1.7
ARG NODE_RUNTIME_BASE=node:22-bookworm-slim
FROM ${NODE_RUNTIME_BASE}
ARG NODE_RUNTIME_BASE

RUN case "$NODE_RUNTIME_BASE" in \
  *@sha256:*) ;; \
  *) echo "NODE_RUNTIME_BASE must be pinned to an immutable digest (e.g. node:22-bookworm-slim@sha256:...)." >&2; exit 1 ;; \
esac

WORKDIR /app
ENV NODE_ENV=production \
    HOME=/tmp \
    TMPDIR=/tmp \
    CI=true

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY scripts/staging-s2g-db-admin-diagnostic.mjs /app/scripts/staging-s2g-db-admin-diagnostic.mjs
COPY scripts/s2g-db-admin-diagnostic-lib.mjs /app/scripts/s2g-db-admin-diagnostic-lib.mjs
COPY scripts/postgres-connection.mjs /app/scripts/postgres-connection.mjs
COPY scripts/postgres-ca-preflight.mjs /app/scripts/postgres-ca-preflight.mjs
COPY infra/staging/certificates/aws-rds-global-bundle.pem /app/certs/rds-global-bundle.pem

RUN chown -R node:node /app
USER node
ENTRYPOINT ["node", "scripts/staging-s2g-db-admin-diagnostic.mjs"]
