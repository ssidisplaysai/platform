{
  "family": "genesis-staging-web",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "taskRoleArn": "${TASK_ROLE_ARN}",
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "GenesisWebRuntime",
      "image": "${IMAGE_URI_WITH_DIGEST}",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "GENESIS_ENVIRONMENT", "value": "staging" },
        { "name": "GENESIS_STONER_GYM_RECRUITED_CREATORS", "value": "jessica" },
        { "name": "GIT_COMMIT", "value": "${GIT_COMMIT}" }
      ],
      "secrets": [
        { "name": "GENESIS_WOOCOMMERCE_WEBHOOK_SECRET", "valueFrom": "${WEBHOOK_SECRET_ARN}" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/genesis/staging/web",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "web"
        }
      }
    }
  ]
}
