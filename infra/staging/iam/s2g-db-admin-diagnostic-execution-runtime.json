{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowScopedEcrReadForDiagnosticRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-west-2:452630323448:repository/genesis-staging-s2g-db-admin-diagnostic"
    },
    {
      "Sid": "AllowEcrAuthorizationTokenReadOnly",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "AllowDiagnosticLogStreamWritesOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-west-2:452630323448:log-group:/genesis/staging/s2g-db-admin-diagnostic:log-stream:*"
    },
    {
      "Sid": "AllowReadOnlyStagingRdsAdminSecretOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:us-west-2:452630323448:secret:rds!db-c18c1e63-98a4-4072-9654-9df53b9fe2e5-NcAenP"
    }
  ]
}

